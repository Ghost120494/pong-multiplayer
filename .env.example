# Optional local configuration. Never commit real credentials.
# Load explicitly with Node 20.20+: node --env-file=.env dist/server.js
PORT=8080
NODE_ENV=development
PUPPY_DATA_DIR=./.puppy-data
PUPPY_PUBLIC_URL=http://localhost:8080
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Non-payable placeholder; configure a real merchant privately to enable web checkout.
PAYPAL_MERCHANT_EMAIL=merchant@example.invalid
PAYPAL_SANDBOX_MERCHANT_EMAIL=
